# Copy to .env for local builds. NEVER commit the real token.
# Create a scoped Airtable personal access token (read-only is enough for the site)
# with access to this one base, then paste it here.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appwMCCtt57i8SNbR

# --- Supabase build (npm run build:supabase) ---
# Server-side build only: the service_role key bypasses RLS so draft rows publish
# too. NEVER commit the real key or expose it in the browser (the site ships
# static JSON, so no key reaches the client).
SUPABASE_URL=https://uobidcahmrmfdmfbrtkt.supabase.co
SUPABASE_SERVICE_KEY=
